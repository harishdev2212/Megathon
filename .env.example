# ====================================================================
# EduGenAI Hackathon Environment Configuration
# ====================================================================
# 1. Copy this file to .env:
#    cp .env.example .env   (or rename a copy in your editor)
# 2. Add your Google Gemini API key below.
# ====================================================================

# Google Gemini API Key (Get one from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Model Configuration (default: gemini-2.5-flash)
# Options: gemini-2.5-flash, gemini-3.8-flash, etc.
GEMINI_MODEL=gemini-2.5-flash

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_SIZE_MB=20
